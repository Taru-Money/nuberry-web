+# ── taru.money -> nuberry.in (marketing pages only) ──────────────
+# The marketing site moved to nuberry.in. Each old page 301s to the same
+# page there, so search rankings carry over. App routes (/login, /signup,
+# /parent/*, /child/*, /app/*) are NOT redirected: the pilot app still
+# lives here. These must stay above the SPA catch-all below.
+[[redirects]]
+  from = "/"
+  to = "https://nuberry.in/"
+  status = 301
+  force = true
+[[redirects]]
+  from = "/about"
+  to = "https://nuberry.in/about/"
+  status = 301
+  force = true
+[[redirects]]
+  from = "/about/"
