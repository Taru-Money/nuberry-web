+  status = 301
+  force = true
+[[redirects]]
+  from = "/calculator/"
+  to = "https://nuberry.in/calculator/"
+  status = 301
+  force = true
+[[redirects]]
+  from = "/tax-calculator"
+  to = "https://nuberry.in/tax-calculator/"
+  status = 301
+  force = true
+[[redirects]]
+  from = "/tax-calculator/"
+  to = "https://nuberry.in/tax-calculator/"
+  status = 301
+  force = true
+[[redirects]]
+  from = "/blog"
+  to = "https://nuberry.in/blog/"
+  status = 301
+  force = true
+[[redirects]]
+  from = "/blog/*"
+  to = "https://nuberry.in/blog/:splat"
