---
import Base from '../layouts/Base.astro'
import { SITE_URL, COMPANY, CONTACT_EMAIL, FOUNDER, ORG_ID, EDITORIAL_POLICY_PATH } from '../lib/site.js'

const description =
  "How Nuberry writes, sources, checks and corrects its guides for parents, and how we earn money as a mutual fund distributor."
// Change this date whenever the policy itself changes.
const lastUpdated = '2026-11-03'
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Editorial policy',
  url: `${SITE_URL}${EDITORIAL_POLICY_PATH}`,
  dateModified: lastUpdated,
  about: { '@id': ORG_ID },
  publisher: { '@id': ORG_ID },
}]
---
<Base
  title="Editorial Policy: How We Write Our Guides | Nuberry"
  description={description}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Editorial policy', path: EDITORIAL_POLICY_PATH }]}
>
  <section class="wrap page-head">
    <span class="eyebrow">How we work</span>
    <h1 class="display">Editorial policy</h1>
    <p class="lede">What you can expect from every guide on Nuberry, and what you shouldn't.</p>
  </section>

  <section class="wrap legal">
    <div class="prose">
      <p><time datetime={lastUpdated}>Last updated 3 November 2026</time></p>

      <h2>Who writes our guides</h2>
      <p>
        Our guides are written by <a href={FOUNDER.path}>{FOUNDER.name}</a>, founder of Nuberry. Each article shows who
        wrote it and when it was published or last updated. We may use software, including AI tools, for research and
        drafting. A person checks every fact against the sources below and is responsible for what we publish.
      </p>

      <h2>Where our facts come from</h2>
      <p>We rely on primary sources wherever one exists:</p>
      <ul>
        <li>SEBI regulations and circulars, for rules on minor folios, KYC and how mutual funds work</li>
        <li>AMFI, for distributor rules and investor education material</li>
        <li>The Income Tax Act and CBDT notifications, for tax treatment, including clubbing of a minor's income</li>
        <li>Scheme Information Documents and Key Information Memoranda from fund houses, for scheme-level details</li>
        <li>Government notifications, for rates on small savings schemes such as PPF and Sukanya Samriddhi</li>
      </ul>
      <p>When a rule is new or unclear, we say so rather than guess.</p>

      <h2>How we show numbers</h2>
      <ul>
        <li>Every return figure is an assumption, and we state the assumption next to it.</li>
        <li>We never promise or imply guaranteed returns. Mutual funds can lose money.</li>
        <li>Examples are illustrative. They are not projections for any scheme.</li>
        <li>Our calculators show their assumptions on the page, and you can change them.</li>
      </ul>

      <h2>What we don't do</h2>
      <ul>
        <li>We don't recommend specific schemes in our guides, and nothing we publish is personalised investment advice.</li>
        <li>We don't accept payment from fund houses or anyone else to publish, rank or mention a product.</li>
        <li>We don't offer rewards, cashback or gifts for investing or inviting others.</li>
      </ul>

      <h2>How we earn money</h2>
      <p>
        Nuberry is a brand of {COMPANY.legalName}, an AMFI-registered mutual fund distributor (ARN {COMPANY.arn}). When
        parents invest through us, the fund house pays us a trail commission. We think you should know that when you read
        anything we write about investing.
      </p>

      <h2>Keeping guides current</h2>
      <p>
        Rules on tax, KYC and minor accounts change. We review a guide when a rule it relies on changes, and update the
        date shown on the article when we change its substance.
      </p>

      <h2>Corrections</h2>
      <p>
        If you spot something wrong or out of date, email <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> with the
        page and what needs fixing. We check every report and correct confirmed errors.
      </p>
    </div>
  </section>
</Base>
