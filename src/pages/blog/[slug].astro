---
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import BlogBody from '../../components/BlogBody.astro'
import WaitlistForm from '../../components/WaitlistForm.astro'
import { blogs } from '../../data/blogs.js'
import { SITE_URL, BRAND, COMPANY, RISK_DISCLAIMER, FOUNDER, ORG_ID, PERSON_ID, EDITORIAL_POLICY_PATH } from '../../lib/site.js'

export function getStaticPaths() {
  return blogs.map((blog, i) => ({
    params: { slug: blog.slug },
    props: { blog, next: blogs[(i + 1) % blogs.length] },
  }))
}
const { blog, next } = Astro.props
const url = `${SITE_URL}/blog/${blog.slug}/`
const modified = blog.dateModified || blog.datePublished
const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' })
const updatedLabel = modified !== blog.datePublished ? `Updated ${fmt(modified)}` : fmt(blog.datePublished)
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: blog.title,
  description: blog.metaDescription,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  image: `${SITE_URL}/og-image.png`,
  datePublished: blog.datePublished,
  dateModified: modified,
  inLanguage: 'en-IN',
  author: { '@type': 'Person', '@id': PERSON_ID, name: FOUNDER.name, url: `${SITE_URL}${FOUNDER.path}` },
  publisher: { '@id': ORG_ID },
}]
// Articles with an FAQ block also get FAQPage markup. Google rarely shows it
// as a rich result now, but AI answer engines read it.
const faqItems = blog.body.filter((b: any) => b.type === 'faq').flatMap((b: any) => b.items)
const plain = (t: string) => t.replace(/\*\*([^*]+)\*\*/g, '$1').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
if (faqItems.length) jsonLd.push({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((f: any) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: plain(f.a) },
  })),
} as any)
// Optional per-article waitlist copy, so the ask matches the page.
const cta = blog.waitlist || { title: 'The hardest part is starting', text: "Join the waitlist and we'll tell you the day it opens." }
---
<Base title={blog.seoTitle || `${blog.title} | Nuberry`} description={blog.metaDescription} ogType="article" active="blog" jsonLd={jsonLd}
  article={{ published: blog.datePublished, modified }}
  breadcrumbs={[{ name: 'Learn', path: '/blog/' }, { name: blog.title, path: `/blog/${blog.slug}/` }]}>
  <article class="wrap article">
    <a href="/blog/" class="back"><Icon name="arrow-left" />All articles</a>
    <header class="article__head">
      {blog.topic && <span class="tag">{blog.topic}</span>}
      <h1 class="display article__title">{blog.title}</h1>
      <p class="lede">{blog.subtitle}</p>
      <div class="byline">
        <span>By <a href={FOUNDER.path} rel="author">{FOUNDER.name}</a></span>
        <time datetime={modified}>{updatedLabel}</time>
        <span>{blog.readingTime} read</span>
        <button type="button" class="nb-btn nb-btn--text" data-share><Icon name="share-2" /><span>Share</span></button>
      </div>
    </header>
    <div class="prose article__body">
      <BlogBody body={blog.body} />
    </div>
    <p class="article__disclaimer">
      {BRAND} is an AMFI-registered mutual fund distributor (ARN {COMPANY.arn}). Nothing here is personalised investment
      advice or a recommendation to buy any particular scheme. Figures are illustrative and based on the assumptions stated
      above. {RISK_DISCLAIMER} How we write and check these guides: <a href={EDITORIAL_POLICY_PATH}>editorial policy</a>.
    </p>
    <a href={`/blog/${next.slug}/`} class="next-article">
      <span class="eyebrow">Next article</span>
      <b>{next.title}</b>
      <span>{next.subtitle}</span>
      <span class="post-card__go">Read it<Icon name="arrow-right" /></span>
    </a>
    <section class="article__waitlist">
      <h2 class="h3">{cta.title}</h2>
      <p>{cta.text}</p>
      <WaitlistForm source={`article:${blog.slug}`} />
    </section>
  </article>
</Base>
