---
import '@fontsource/baloo-2/600.css'
import '@fontsource/baloo-2/700.css'
import '@fontsource/baloo-2/800.css'
import '@fontsource/figtree/latin-400.css'
import '@fontsource/figtree/latin-500.css'
import '@fontsource/figtree/latin-600.css'
import '@fontsource/figtree/latin-700.css'
import '../styles/tokens.css'
import '../styles/components.css'
import '../styles/site.css'
// Every Figtree weight (all used above the fold) and the h1 weight are
// preloaded, so text doesn't reflow when they arrive. That reflow was a
// layout shift of 0.15 to 0.19 on long articles.
import figtree400 from '@fontsource/figtree/files/figtree-latin-400-normal.woff2?url'
import figtree500 from '@fontsource/figtree/files/figtree-latin-500-normal.woff2?url'
import figtree600 from '@fontsource/figtree/files/figtree-latin-600-normal.woff2?url'
import figtree700 from '@fontsource/figtree/files/figtree-latin-700-normal.woff2?url'
import baloo800 from '@fontsource/baloo-2/files/baloo-2-latin-800-normal.woff2?url'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import WaitlistBand from '../components/WaitlistBand.astro'
import { SITE_URL, BRAND, COMPANY, ANALYTICS, SOCIAL_LINKS, ORG_ID, PERSON_ID, CONTACT_EMAIL, FOUNDER } from '../lib/site.js'

interface Props {
  title: string
  description: string
  ogTitle?: string
  ogDescription?: string
  ogType?: 'website' | 'article'
  jsonLd?: object[]
  active?: 'calculator' | 'blog' | 'about'
  noindex?: boolean
  // Trail below Home, e.g. [{ name: 'Learn', path: '/blog/' }]. Home is added
  // automatically and the last item is the current page. Leave out on the home page.
  breadcrumbs?: { name: string; path: string }[]
  // True when the page has its own waitlist form with id="waitlist". Otherwise
  // the waitlist band is added at the bottom of the page.
  ownWaitlist?: boolean
  // Articles only: ISO dates for article:published_time / modified_time.
  article?: { published: string; modified: string }
}
const {
  title, description, ogTitle = title, ogDescription = description,
  ogType = 'website', jsonLd = [], active, noindex = false, breadcrumbs = [], article, ownWaitlist = false,
} = Astro.props

const canonical = new URL(Astro.url.pathname, SITE_URL).href
const ogImage = `${SITE_URL}/og-image.png`
const ogImageAlt = `${BRAND}: Paisa bhi. Samajh bhi.`
const orgLd = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'FinancialService'],
  '@id': ORG_ID,
  name: BRAND,
  legalName: COMPANY.legalName,
  url: SITE_URL,
  logo: { '@type': 'ImageObject', url: `${SITE_URL}/brand/nuberry-icon-dark.png`, width: 512, height: 512 },
  image: ogImage,
  description: `AMFI-registered mutual fund distributor (ARN ${COMPANY.arn}) helping Indian parents invest in their child's name.`,
  areaServed: { '@type': 'Country', name: 'India' },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: CONTACT_EMAIL,
    areaServed: 'IN',
    availableLanguage: ['en', 'hi'],
  },
  identifier: [
    { '@type': 'PropertyValue', propertyID: 'AMFI ARN', value: COMPANY.arn },
    { '@type': 'PropertyValue', propertyID: 'CIN', value: COMPANY.cin },
  ],
  address: { '@type': 'PostalAddress', addressLocality: 'Mumbai', addressRegion: 'Maharashtra', postalCode: '400064', addressCountry: 'IN' },
  founder: { '@id': PERSON_ID },
  sameAs: SOCIAL_LINKS.map((s) => s.url).filter(Boolean),
}
const breadcrumbLd = breadcrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(c.path, SITE_URL).href,
      })),
    }
  : null
const analyticsConfig = JSON.stringify(ANALYTICS)
---
<!doctype html>
<html lang="en-IN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Set the theme before first paint. Default light; the toggle stores a choice.
      (function () {
        try {
          var t = localStorage.getItem('nb-theme')
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t
        } catch (e) {}
      })()
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow" />}
    <meta name="theme-color" content="#fffcf5" />
    {[figtree400, figtree500, figtree600, figtree700].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <link rel="preload" href={baloo800} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {article && <meta property="article:published_time" content={article.published} />}
    {article && <meta property="article:modified_time" content={article.modified} />}
    {article && <meta property="article:author" content={`${SITE_URL}${FOUNDER.path}`} />}
    {article && <meta name="author" content={FOUNDER.name} />}
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />


    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}

    <script is:inline define:vars={{ analyticsConfig }}>
      // Ads, GA4 and the Meta pixel load only on the production host, never on previews or localhost.
      // Calls are queued straight away (gtag via dataLayer, fbq via its stub), but the vendor
      // scripts are fetched only on the first interaction or 3.5s after load, so they never
      // compete with the page itself. Nothing is lost: queued calls run when the scripts arrive.
      (function () {
        var cfg = JSON.parse(analyticsConfig)
        // nbTrack(name, params): a GA4 event. nbTrackLead(source): a waitlist sign-up,
        // sent to GA4 as generate_lead and to Ads and Meta as a conversion.
        // Both are no-ops off the production host.
        window.nbTrack = function () {}
        window.nbTrackLead = function () {}
        if (cfg.productionHosts.indexOf(location.hostname) === -1) return
        window.dataLayer = window.dataLayer || []
        window.gtag = function () { dataLayer.push(arguments) }
        gtag('js', new Date())
        gtag('config', cfg.googleAdsId)
        if (cfg.ga4Id) gtag('config', cfg.ga4Id)
        window.nbTrack = function (name, params) {
          if (!cfg.ga4Id) return
          try { gtag('event', name, Object.assign({ send_to: cfg.ga4Id }, params || {})) } catch (e) {}
        }
        // Meta pixel stub (the standard snippet, minus the script tag it inserts).
        var n = window.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments) }
        if (!window._fbq) window._fbq = n
        n.push = n; n.loaded = true; n.version = '2.0'; n.queue = []
        fbq('init', cfg.metaPixelId)
        fbq('track', 'PageView')
        window.nbTrackLead = function (source) {
          window.nbTrack('generate_lead', { lead_source: source || 'unknown' })
          try { fbq('track', 'Lead') } catch (e) {}
          try { gtag('event', 'conversion', { send_to: cfg.googleAdsLeadConversion }) } catch (e) {}
        }
        var loaded = false
        var events = ['pointerdown', 'keydown', 'scroll', 'touchstart']
        function add(src) {
          var s = document.createElement('script')
          s.async = true
          s.src = src
          document.head.appendChild(s)
        }
        function load() {
          if (loaded) return
          loaded = true
          events.forEach(function (e) { removeEventListener(e, load, { passive: true }) })
          add('https://www.googletagmanager.com/gtag/js?id=' + cfg.googleAdsId)
          add('https://connect.facebook.net/en_US/fbevents.js')
        }
        events.forEach(function (e) { addEventListener(e, load, { once: true, passive: true }) })
        addEventListener('load', function () { setTimeout(load, 3500) })
      })()
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header active={active} />
    <main id="main">
      <slot />
      {!ownWaitlist && <WaitlistBand source={`page:${Astro.url.pathname}`} />}
    </main>
    <Footer />
    <script>
      import '../lib/client.js'
    </script>
  </body>
</html>
