---
import Logo from './Logo.astro'
import Icon from './Icon.astro'

interface Props { active?: 'calculator' | 'blog' | 'about' }
const { active } = Astro.props
const isHome = Astro.url.pathname === '/'
const waitlistHref = isHome ? '#waitlist' : '/#waitlist'
const links = [
  { href: '/calculator/', label: 'Tools', key: 'calculator' },
  { href: '/blog/', label: 'Learn', key: 'blog' },
  { href: '/about/', label: 'About', key: 'about' },
]
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Nuberry home">
      <Logo variant="lockup" width={216} class="logo--lockup" />
      <Logo variant="wordmark" width={112} class="logo--wordmark" />
    </a>
    <nav class="site-nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} class="site-nav__link" aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>
    <div class="site-header__end">
      <button type="button" class="nb-iconbtn theme-toggle" data-theme-toggle aria-label="Switch between light and dark mode">
        <Icon name="moon" class="theme-toggle__moon" />
        <Icon name="sun" class="theme-toggle__sun" />
      </button>
      <a href={waitlistHref} class="nb-btn nb-btn--primary nb-btn--sm site-header__cta">Join the waitlist</a>
      <details class="site-menu">
        <summary class="nb-iconbtn" aria-label="Menu">
          <Icon name="menu" class="site-menu__open" />
          <Icon name="x" class="site-menu__close" />
        </summary>
        <div class="site-menu__panel">
          {links.map((l) => (
            <a href={l.href} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>
          ))}
          <a href="/tax-calculator/">Tax calculator</a>
          <a href={waitlistHref} class="nb-btn nb-btn--primary nb-btn--block">Join the waitlist</a>
        </div>
      </details>
    </div>
  </div>
</header>
