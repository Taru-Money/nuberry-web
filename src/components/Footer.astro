---
import Logo from './Logo.astro'
import { COMPANY, CONTACT_EMAIL, SOCIAL_LINKS, RISK_DISCLAIMER, TAGLINE } from '../lib/site.js'
const year = new Date().getFullYear()
const socialPaths = {
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.1" cy="6.9" r="0.6" fill="currentColor" stroke="none"/>',
  linkedin: '<rect x="3.5" y="3.5" width="17" height="17" rx="2.5"/><path d="M8 10.5V16"/><circle cx="8" cy="7.6" r="0.6" fill="currentColor" stroke="none"/><path d="M11.5 16v-5.5"/><path d="M11.5 13a2.25 2.25 0 0 1 4.5 0v3"/>',
  facebook: '<path d="M14.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.5V4.4c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8v2.4H9.2v3h2.5V21"/>',
}
---
<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <Logo variant="wordmark" width={120} onDark />
      <p class="site-footer__tagline">{TAGLINE}</p>
    </div>
    <nav class="site-footer__links" aria-label="Footer">
      <a href="/about/">About</a>
      <a href="/blog/">Learn</a>
      <a href="/calculator/">SIP calculator</a>
      <a href="/tax-calculator/">Tax calculator</a>
      <a href="/privacy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="/eula/">EULA</a>
      <a href={`mailto:${CONTACT_EMAIL}`}>Contact</a>
    </nav>
    <ul class="site-footer__social" aria-label="Nuberry on social media">
      {SOCIAL_LINKS.map((s) => (
        <li>
          <a
            href={s.url ?? undefined}
            aria-label={`Nuberry on ${s.label}`}
            {...(s.url ? { target: '_blank', rel: 'noopener noreferrer' } : { 'data-todo': 'url-missing' })}
          >
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={socialPaths[s.icon]} />
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="wrap site-footer__legal">
    <p>
      Nuberry is a brand of {COMPANY.legalName}, an AMFI-registered mutual fund distributor.
      ARN: {COMPANY.arn}. CIN: {COMPANY.cin}. Registered office: {COMPANY.address}.
    </p>
    <p>{RISK_DISCLAIMER} Nuberry does not guarantee returns.</p>
    <p>App screens are illustrative. Figures are examples, not returns or projections.</p>
    <p>© {year} {COMPANY.legalName}</p>
  </div>
</footer>
